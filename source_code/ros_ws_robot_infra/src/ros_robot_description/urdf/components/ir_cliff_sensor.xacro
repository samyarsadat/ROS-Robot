<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="ir_cliff_sensor" params="parent_link name_prefix namespace xyz rpy">
        <xacro:property name="mesh_file" value="package://ros_robot_description/meshes/components/ir_cliff_sensor.dae" />
        <xacro:property name="namespace_fmt" value="${namespace + '/' if namespace != '' else ''}" />

        <xacro:property name="component_config_file" value="$(find ros_robot_description)/config/components_config.yaml" />
        <xacro:property name="component_config" value="${xacro.load_yaml(component_config_file)['ir_cliff_sensor']}"/>

        <joint name="${name_prefix}_cliff_sens_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="${name_prefix}_cliff_sens_link" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>

        <link name="${name_prefix}_cliff_sens_link">
            <visual>
                <geometry>
                    <mesh filename="${mesh_file}" scale="1.0 1.0 1.0" />
                </geometry>
            </visual>
        </link>

        <gazebo reference="${name_prefix}_cliff_sens_link">
            <sensor type="gpu_lidar" name="${namespace_fmt}${name_prefix}_cliff_sensor">
                <pose>0 0 -0.003 ${-pi/2} 0 0</pose>
                <update_rate>${component_config["simulation"]["update_rate"]}</update_rate>
                <topic>${namespace_fmt}${name_prefix}_cliff_sensor/range</topic>
                <gz_frame_id>${namespace_fmt}${name_prefix}_cliff_sens_link</gz_frame_id>
                <visualize>false</visualize>

                <lidar>
                    <scan>
                        <horizontal>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>0.4</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>