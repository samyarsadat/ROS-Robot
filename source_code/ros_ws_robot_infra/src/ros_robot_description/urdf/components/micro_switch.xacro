<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="micro_switch" params="parent_link name_prefix namespace xyz rpy">
        <xacro:property name="mesh_file" value="package://ros_robot_description/meshes/components/micro_switch.dae" />
        <xacro:property name="namespace_fmt" value="${namespace + '/' if namespace != '' else ''}" />

        <xacro:property name="component_config_file" value="$(find ros_robot_description)/config/components_config.yaml" />
        <xacro:property name="component_config" value="${xacro.load_yaml(component_config_file)['micro_switch']}"/>

        <joint name="${name_prefix}_microswitch_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="${name_prefix}_microswitch_link" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>

        <link name="${name_prefix}_microswitch_link">
            <visual>
                <geometry>
                    <mesh filename="${mesh_file}" scale="1.0 1.0 1.0" />
                </geometry>
            </visual>

            <collision name="${name_prefix}_microswitch_collision">
                <origin xyz="0.004 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.018 0.006 0.02"/>
                </geometry>
            </collision>
        </link>

        <gazebo reference="${name_prefix}_microswitch_link">
            <sensor type="contact" name="${namespace_fmt}${name_prefix}_microswitch_sensor">
                <update_rate>${component_config["simulation"]["update_rate"]}</update_rate>
                <topic>${namespace_fmt}${name_prefix}_microswitch/contact</topic>
                <gz_frame_id>${namespace_fmt}${name_prefix}_microswitch_link</gz_frame_id>

                <contact>
                    <collision>${namespace_fmt}${name_prefix}_microswitch_collision</collision>
                </contact>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>