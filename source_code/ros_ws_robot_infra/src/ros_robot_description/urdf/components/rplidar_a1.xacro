<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="rplidar" params="parent_link name_prefix:='' namespace xyz rpy">
        <xacro:property name="namespace_fmt" value="${namespace + '/' if namespace != '' else ''}" />
        <xacro:property name="name_prefix_fmt" value="${name_prefix + '_' if name_prefix != '' else ''}" />

        <xacro:property name="component_config_file" value="$(find ros_robot_description)/config/components_config.yaml" />
        <xacro:property name="component_config" value="${xacro.load_yaml(component_config_file)['rplidar']}"/>

        <xacro:property name="mass" value="0.190" />
        <xacro:property name="radius" value="0.035" />
        <xacro:property name="height" value="0.055" />
        <xacro:property name="sensor_dist_from_top" value="0.008" />

        <joint name="${name_prefix_fmt}lidar_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="${name_prefix_fmt}lidar_link" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>

        <xacro:property name="collision_mesh">
            <origin xyz="0 0 ${height/2.0}" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${radius}" length="${height}" />
            </geometry>
        </xacro:property>

        <link name="${name_prefix_fmt}lidar_link">
            <visual>
                <!-- No proper Collada mesh for the RPLiDAR-A1M8 yet -->
                <xacro:insert_block name="collision_mesh" />
                <material name="solid_red"/>
            </visual>

            <collision>
                <xacro:insert_block name="collision_mesh" />
            </collision>

            <xacro:inertial_cylinder mass="${mass}" length="${height}" radius="${radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="${name_prefix_fmt}lidar_laser_joint" type="fixed">
            <origin xyz="0 0 ${height-sensor_dist_from_top}" rpy="0 0 0" />
            <parent link="${name_prefix_fmt}lidar_link" />
            <child link="${name_prefix_fmt}lidar_laser_link" />
        </joint>

        <link name="${name_prefix_fmt}lidar_laser_link" />

        <gazebo reference="${name_prefix_fmt}lidar_link">
            <material>Gazebo/Red</material>

            <sensor type="gpu_lidar" name="${namespace_fmt}${name_prefix}_laser_sensor">
                <pose>0 0 ${height-sensor_dist_from_top} 0 0 0</pose>
                <visualize>false</visualize>
                <update_rate>${component_config["simulation"]["update_rate"]}</update_rate>
                <topic>${namespace_fmt}${name_prefix_fmt}lidar/scan</topic>
                <gz_frame_id>${namespace_fmt}${name_prefix_fmt}lidar_laser_link</gz_frame_id>

                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-${pi}</min_angle>
                            <max_angle>${pi}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.15</min>
                        <max>12</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.1</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>